# Optional Plausible site domain. Use only the hostname from Plausible,
# without https:// or a path (for example: madhuresume.netlify.app).
REACT_APP_PLAUSIBLE_DOMAIN=madhuresume.netlify.app
# Local-only opt-in. Use a separate Plausible site/domain for localhost so test
# traffic is not mixed into production analytics.
REACT_APP_PLAUSIBLE_ENABLE_IN_DEV=false

# Optional Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
# Create a GA4 Web data stream and use its Measurement ID.
REACT_APP_GA_MEASUREMENT_ID=

# Local-only opt-in. Prefer a separate GA4 property/measurement ID for testing.
REACT_APP_GA_ENABLE_IN_DEV=false
